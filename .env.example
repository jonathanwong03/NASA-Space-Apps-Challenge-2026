# Copy to .env (optional - every value has a default)

# Enables Claude-powered Q&A and investigation briefs in the insights service.
# Without it the dashboard uses its offline rule-based SI engine.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Ports on your machine
WEB_PORT=8080
DB_PORT=5433

# Postgres credentials
POSTGRES_USER=firesafe
POSTGRES_PASSWORD=firesafe
POSTGRES_DB=firesafe

# Pull fresh data from the NASA PSI API every time the stack starts
SYNC_ON_STARTUP=true
